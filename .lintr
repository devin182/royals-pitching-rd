linters: linters_with_defaults(
    line_length_linter(140),
    semicolon_linter = semicolon_linter(allow_compound = TRUE),
    object_name_linter = NULL,
    object_usage_linter = NULL,
    commented_code_linter = NULL,
    brace_linter = NULL,
    indentation_linter = NULL,
    infix_spaces_linter = NULL,
    quotes_linter = NULL,
    return_linter = NULL
  )
exclusions: list("site", "data", "site_src", "brand", "notes", "tunnel", "gameplan", "design_v2")
encoding: "UTF-8"
